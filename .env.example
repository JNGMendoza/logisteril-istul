# =============================================
# LogiSteril ISTUL — Variables de entorno
# Copia este archivo como .env y edita los valores
# =============================================

# Clave secreta Flask (CAMBIAR en producción — mínimo 32 caracteres aleatorios)
SECRET_KEY=cambia-esta-clave-por-una-muy-segura-y-larga-2024

# Base de datos
# SQLite (desarrollo — se crea automáticamente):
DATABASE_URL=sqlite:///logisteril.db

# PostgreSQL (producción):
# DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/logisteril

# Entorno (development / production)
FLASK_ENV=development
FLASK_DEBUG=1
